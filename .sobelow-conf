# Sobelow (Phoenix security scanner) - `mix sobelow --config`, run by precommit and CI.
#
# skip: true  - findings recorded in .sobelow-skips are accepted. Every entry there
# was read in context and is a false positive:
#   * Traversal.* - paths are built by the app (its data dir, temp files, a
#     bundled catalogue) or looked up by id in the app's own listing before they
#     are touched; no request string is ever joined into a path.
#   * XSS.* - bodies are fixed SVG/PDF/ndjson/escaped-HTML builders or the app's own
#     bundled manual; content types are literals.
#   * DOS.StringToAtom - atoms come from the app's own literals, bundled data or a
#     regex-bounded letter set, never from a request.
#   * CI.System - fixed commands with an argument list (no shell string).
#   * Config.CSWH - the socket origin is checked, but by a function, which
#     Sobelow cannot read: config/config.exs sets check_origin to
#     ArkabWeb.HostGuard.origin_allowed?/1, which accepts localhost, 127.0.0.1,
#     ::1, the endpoint url host, ARKAB_HOSTS and (unless ARKAB_LISTEN=local)
#     this machine's own name and addresses. The same list is a plug at the head
#     of the endpoint that answers 403 to any other Host, so a DNS-rebinding page
#     reaches neither the pages nor the socket. What a visitor on the network may
#     do is limited to looking: StatusLive refuses every change unless the peer is
#     this machine (sweep 2026-10-19 ARK-1/ARK-2).
#   * Config.CSP - no script-src policy is set; Phoenix's default
#     put_secure_browser_headers is on the browser pipeline. Reported, not fixed:
#     it listens on localhost / behind the operator's own access layer only.
[
  exit: :low,
  format: "txt",
  ignore: [],
  ignore_files: [],
  include_mix_tasks: false,
  include_scripts: false,
  out: nil,
  private: false,
  router: nil,
  skip: true,
  summary: false,
  threshold: :low,
  verbose: false
]
