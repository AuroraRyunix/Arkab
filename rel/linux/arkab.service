# Arkab as a service: starts with the box, starts again when it falls over.
# Installed by install.sh; kept current by update.sh. Settings an arbiter may
# want to change are in /etc/arkab/arkab.env, not here - this file is
# replaced by updates.

[Unit]
Description=Arkab - the bridge for live boards
Documentation=https://github.com/teapot-chess/Arkab
After=network.target

[Service]
Type=exec
User=arkab
Group=arkab
# The serial ports (/dev/ttyUSB*, /dev/ttyACM*) belong to this group.
SupplementaryGroups=dialout
WorkingDirectory=/var/lib/arkab

Environment=HOME=/var/lib/arkab
Environment=LANG=C.UTF-8
Environment=ARKAB_DATA=/var/lib/arkab
Environment=PORT=4050
# No Erlang distribution: no epmd, no node listening on the hall's network.
Environment=RELEASE_DISTRIBUTION=none
# The release writes its start-up configuration somewhere; /opt is not
# writable for this user, and should not be.
Environment=RELEASE_TMP=/run/arkab
RuntimeDirectory=arkab
# Tells the program that "Download and install" has somebody to ask
# (arkab-update.path), and where that somebody leaves its answer.
Environment=ARKAB_UPDATER=systemd
Environment=ARKAB_UPDATE_STATUS=/var/lib/arkab-update/status
EnvironmentFile=-/etc/arkab/arkab.env

ExecStart=/opt/arkab/current/bin/arkab start
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# Not root, and not able to become it. The whole system read-only except the
# data directory. No home directories, a /tmp of its own.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/arkab
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Deliberately absent: PrivateDevices (the boards are devices) and
# MemoryDenyWriteExecute (the runtime compiles code as it goes).

[Install]
WantedBy=multi-user.target
