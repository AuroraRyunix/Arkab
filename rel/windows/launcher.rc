/*
 * Resources of Arkab.exe, compiled by `zig rc` from build_launcher.ps1.
 *
 * launcher_version.h is written by that script from the version in mix.exs
 * and is not committed.
 */

#include "launcher_version.h"

1 ICON "Arkab.ico"

1 24 "launcher.manifest"

1 VERSIONINFO
FILEVERSION ARKAB_VER_MAJOR, ARKAB_VER_MINOR, ARKAB_VER_PATCH, 0
PRODUCTVERSION ARKAB_VER_MAJOR, ARKAB_VER_MINOR, ARKAB_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Arkab"
            VALUE "FileDescription", "Arkab - live chess boards"
            VALUE "FileVersion", ARKAB_VER_STRING
            VALUE "InternalName", "Arkab"
            VALUE "OriginalFilename", "Arkab.exe"
            VALUE "ProductName", "Arkab"
            VALUE "ProductVersion", ARKAB_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
